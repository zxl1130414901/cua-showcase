# 白名单模式：默认忽略全部，仅放行下列产物
*

# 清单与说明
!.gitignore
!.gitattributes
!manifest.json
!manifest.md

# 展示站数据（含 details、cua_rank.json、wecom_rank.json 历史归档）
!/showcase/
/showcase/*
!/showcase/data/
!/showcase/data/**

# 站点：入库构建产物 + 可复现构建所需的源码与配置
!/showcase/app/
/showcase/app/*
!/showcase/app/dist/
!/showcase/app/dist/*
!/showcase/app/dist/index.html
!/showcase/app/src/
!/showcase/app/src/**
!/showcase/app/scripts/
!/showcase/app/scripts/**
!/showcase/app/index.html
!/showcase/app/package.json
!/showcase/app/package-lock.json
!/showcase/app/tsconfig.json
!/showcase/app/vite.config.ts
!/showcase/app/vitest.config.ts
!/showcase/app/eslint.config.js

# 站点截图与文档
!/showcase/shots/
!/showcase/shots/**
!/showcase/docs/
!/showcase/docs/**
!/showcase/README.md

# 报告：仅入库当前主报告，其余归档不入库
!/_reports/
/_reports/*
!/_reports/summary_report.md
!/_reports/cua_top_list.md
!/_reports/detail_audit.md
